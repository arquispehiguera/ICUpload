{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  // Los valores "CHANGEME" de este archivo son secretos reales de este entorno
  // (SQL Server, Inconcert, API de Pacífico) — completalos en appsettings.Local.json
  // (gitignoreado, ya en .gitignore) en vez de acá, para no commitear credenciales.
  "ConnectionStrings": {
    "AppConnection": "Server=apli1005;Database=B1804_INCONCERT_WEBSERVICE;Integrated Security=True;TrustServerCertificate=True;Connection Timeout=30;",
    "AmbienteConnection": "Data Source={0};Initial Catalog={1};Persist Security Info=True;User ID=CHANGEME;Password=CHANGEME;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "UserName": "admin_ic",
    // CHANGEME: contraseña real del usuario admin_ic en el broker (no es un valor rotable
    // que se pueda inventar acá) — completar antes de desplegar.
    "Password": "CHANGEME",
    "VirtualHost": "/"
  },
  "Lead": {
    "QueueName": "Lead",
    "PrefetchCount": 1
  },
  "InConcert": {
    // Tomados de CargasInconcertWS_C2C_2\CargasInconcertWS_C2C\Web.config (appSettings
    // vs_User/vs_Pass/vs_Port) — no son secretos rotables de este entorno, se copian tal cual.
    "VsUser": "WebserviceGSS",
    "VsPassword": "CHANGEME",
    "VsPort": 8083
  },
  "AlertNotifier": {
    "Enabled": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer", "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "restrictedToMinimumLevel": "Warning",
          "connectionString": "Server=apli1005;Database=B1804_INCONCERT_WEBSERVICE;Integrated Security=True;TrustServerCertificate=True;Connection Timeout=30;",
          "tableName": "GSS_LogICUpload",
          "autoCreateSqlTable": true,
          "batchPostingLimit": 50,
          "period": "00:00:10",
          "columnOptionsSection": {
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "Properties" ],
            "additionalColumns": [
              {
                "ColumnName": "MachineName",
                "DataType": "nvarchar",
                "DataLength": 50
              },
              {
                "ColumnName": "Application",
                "DataType": "nvarchar",
                "DataLength": 100
              },
              {
                "ColumnName": "Celular",
                "DataType": "nvarchar",
                "DataLength": 160
              },
              {
                "ColumnName": "ContactId",
                "DataType": "nvarchar",
                "DataLength": 200
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": { "expression": "@l in ['Debug', 'Information']" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "Logs\\log-.txt",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 30
                }
              }
            ]
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentUserName" ]
  }
}
